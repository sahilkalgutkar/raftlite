# Host ports the three nodes publish. Each is overridable; only the host side
# moves, since inside the compose network every node serves HTTP on 8001 and
# speaks Raft on 9001 regardless.
#
# scripts/demo.sh reads the same three variables with the same defaults, so one
# override moves the compose mapping and the demo together:
#   NODE1_HOST_PORT=8101 NODE2_HOST_PORT=8102 NODE3_HOST_PORT=8103 \
#     ./scripts/demo.sh

NODE1_HOST_PORT=8001
NODE2_HOST_PORT=8002
NODE3_HOST_PORT=8003
